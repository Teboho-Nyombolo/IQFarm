@HOST = http://localhost:
@PORT = 8080
@SERVER = {{HOST}}{{PORT}}

### Create Tracker - Irrigation
POST {{SERVER}}/api/crop-trackers/create
Content-Type: application/json

{
  "cropId": 1,
  "description": "Morning irrigation session for tomato field",
  "status": "ACTIVE",
  "date": "2026-07-03",
  "logType": "IRRIGATION",
  "cost": 150.00,
  "next": "Check soil moisture tomorrow",
  "completed": true
}

